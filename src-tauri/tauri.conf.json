{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContentOS",
  "version": "0.3.0",
  "identifier": "com.contentos.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ContentOS",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "url": "index.html"
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "width": 480,
        "height": 320,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "capture.html"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
